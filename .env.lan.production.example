# Trusted LAN / IoT VLAN only. Never expose this HTTP mode to the public Internet.
TZ=Asia/Taipei
INKTIME_PORT=8765
INKTIME_ENVIRONMENT=production
INKTIME_PUBLIC_URL=http://192.168.1.100:8765
INKTIME_BIND_ADDRESS=192.168.1.100
INKTIME_COOKIE_SECURE=0
INKTIME_ALLOW_INSECURE_HTTP=1
INKTIME_PROXY_TRUST=0
INKTIME_ALLOW_UNSAFE_NETWORK_DATABASE=0

INKTIME_DATA_PATH=/CHANGE_ME/inktime/data
INKTIME_PHOTO_PATH=/CHANGE_ME/photos
INKTIME_IMAGE_TAG=CHANGE_ME_GIT_SHA
INKTIME_GIT_REVISION=CHANGE_ME_GIT_SHA
INKTIME_BUILD_TIME=CHANGE_ME_UTC_BUILD_TIME
