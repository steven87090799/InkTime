{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inktime.local/schemas/benchmark-golden-manifest.schema.json",
  "title": "InkTime Golden Benchmark Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "dataset", "items"],
  "properties": {
    "version": {"type": "string", "const": "inktime-golden-v1"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "privacy"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 120},
        "source": {"type": "string", "enum": ["committed_fixture", "synthetic"]},
        "privacy": {"type": "string", "const": "non_private"}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "image", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 160},
          "image": {"type": "string", "minLength": 1, "maxLength": 300},
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["memory_grade", "beauty_grade", "emotion_grade", "types", "should_keep"],
            "properties": {
              "memory_grade": {"type": "string", "enum": ["E", "D", "C", "B", "A", "S", "unknown"]},
              "beauty_grade": {"type": "string", "enum": ["E", "D", "C", "B", "A", "S", "unknown"]},
              "technical_grade": {"type": "string", "enum": ["E", "D", "C", "B", "A", "S", "unknown"]},
              "technical_quality_grade": {"type": "string", "enum": ["E", "D", "C", "B", "A", "S", "unknown"]},
              "emotion_grade": {"type": "string", "enum": ["E", "D", "C", "B", "A", "S", "unknown"]},
              "types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "should_keep": {"type": "boolean"},
              "rotation_cw": {"type": ["integer", "null"], "enum": [0, 90, 180, 270, null]},
              "ambiguous": {"type": "boolean"},
              "visual_orientation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rotation_cw", "ambiguous"],
                "properties": {
                  "rotation_cw": {"type": ["integer", "null"], "enum": [0, 90, 180, 270, null]},
                  "ambiguous": {"type": "boolean"}
                }
              }
            },
            "allOf": [
              {
                "oneOf": [
                  {"required": ["technical_grade"], "not": {"required": ["technical_quality_grade"]}},
                  {"required": ["technical_quality_grade"], "not": {"required": ["technical_grade"]}}
                ]
              },
              {
                "oneOf": [
                  {
                    "required": ["visual_orientation"],
                    "not": {"anyOf": [{"required": ["rotation_cw"]}, {"required": ["ambiguous"]}]}
                  },
                  {
                    "required": ["rotation_cw", "ambiguous"],
                    "not": {"required": ["visual_orientation"]}
                  }
                ]
              }
            ]
          },
          "expected_rank": {"type": "number"},
          "expected_score": {"type": "number"},
          "never_upload": {"type": "boolean"},
          "inactive": {"type": "boolean"},
          "ineligible": {"type": "boolean"},
          "missing": {"type": "boolean"},
          "manually_excluded": {"type": "boolean"}
        }
      }
    }
  }
}
