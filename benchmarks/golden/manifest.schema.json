{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inktime.local/schemas/benchmark-golden-manifest.schema.json",
  "title": "InkTime Golden Benchmark Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "dataset",
    "items"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "inktime-golden-v1"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "privacy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "source": {
          "type": "string",
          "enum": [
            "committed_fixture",
            "synthetic"
          ]
        },
        "privacy": {
          "type": "string",
          "const": "non_private"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "image",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "image": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "memory_score",
              "visual_score",
              "special_level",
              "types",
              "should_keep"
            ],
            "properties": {
              "types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "人物",
                    "其他",
                    "夜景",
                    "孩子",
                    "家庭",
                    "寵物",
                    "建築",
                    "截圖",
                    "收據",
                    "文件",
                    "旅行",
                    "日常",
                    "植物",
                    "活動",
                    "美食",
                    "貓咪",
                    "雜物",
                    "風景"
                  ]
                },
                "uniqueItems": true,
                "minItems": 1,
                "maxItems": 3
              },
              "should_keep": {
                "type": "boolean"
              },
              "rotation_cw": {
                "type": [
                  "integer",
                  "null"
                ],
                "enum": [
                  0,
                  90,
                  180,
                  270,
                  null
                ]
              },
              "ambiguous": {
                "type": "boolean"
              },
              "visual_orientation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rotation_cw",
                  "ambiguous"
                ],
                "properties": {
                  "rotation_cw": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "enum": [
                      0,
                      90,
                      180,
                      270,
                      null
                    ]
                  },
                  "ambiguous": {
                    "type": "boolean"
                  }
                }
              },
              "memory_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "visual_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "special_level": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            },
            "allOf": [
              {
                "oneOf": [
                  {
                    "required": [
                      "visual_orientation"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "rotation_cw"
                          ]
                        },
                        {
                          "required": [
                            "ambiguous"
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "required": [
                      "rotation_cw",
                      "ambiguous"
                    ],
                    "not": {
                      "required": [
                        "visual_orientation"
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "expected_rank": {
            "type": "number"
          },
          "expected_score": {
            "type": "number"
          },
          "never_upload": {
            "type": "boolean"
          },
          "inactive": {
            "type": "boolean"
          },
          "ineligible": {
            "type": "boolean"
          },
          "missing": {
            "type": "boolean"
          },
          "manually_excluded": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
