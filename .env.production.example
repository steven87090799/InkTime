# Replace the example hostname before startup. Production rejects placeholder domains.
TZ=Asia/Taipei
INKTIME_PORT=8765
INKTIME_DATA_PATH=./data
INKTIME_PHOTO_PATH=./simulation_photos
INKTIME_ENVIRONMENT=production
INKTIME_PUBLIC_URL=https://inktime.example.com
INKTIME_COOKIE_SECURE=1
INKTIME_ALLOW_INSECURE_HTTP=0
INKTIME_ALLOW_UNSAFE_NETWORK_DATABASE=0
INKTIME_PROXY_TRUST=1
INKTIME_IMAGE_TAG=local
