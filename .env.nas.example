# Copy this file to .env.nas on the NAS. Never commit .env.nas.
# Public images need no login. For a private GHCR package, log in once as documented.
INKTIME_IMAGE_REPOSITORY=ghcr.io/steven87090799/inktime
# INKTIME_IMAGE_TAG is supplied by scripts/update_nas.sh for each deployment.
# Mutable latest is refused unless INKTIME_ALLOW_MUTABLE_IMAGE_TAG=1 is explicitly set.
INKTIME_ALLOW_MUTABLE_IMAGE_TAG=0

TZ=Asia/Taipei
INKTIME_PORT=8765
# Keep 127.0.0.1 when a reverse proxy runs on the same NAS. For direct trusted-LAN
# access, replace it with the NAS LAN IP instead of exposing all interfaces.
INKTIME_BIND_ADDRESS=127.0.0.1

# Use absolute NAS paths. Keep SQLite data on a local ext4/xfs/btrfs volume;
# INKTIME_PHOTO_PATH may point to the NAS photo library and is mounted read-only.
INKTIME_DATA_PATH=/CHANGE_ME/inktime/data
INKTIME_PHOTO_PATH=/CHANGE_ME/photos

# HTTPS reverse-proxy defaults. Replace the URL and keep these values together.
INKTIME_PUBLIC_URL=https://inktime.example.com
INKTIME_COOKIE_SECURE=1
INKTIME_ALLOW_INSECURE_HTTP=0
INKTIME_PROXY_TRUST=1
INKTIME_ALLOW_UNSAFE_NETWORK_DATABASE=0

INKTIME_LOG_FORMAT=json
INKTIME_LOG_LEVEL=INFO
INKTIME_ACCESS_LOG=0
INKTIME_LOG_MAX_SIZE=5m
INKTIME_LOG_MAX_FILES=3

# Intel N100 / small NAS defaults.
INKTIME_WEB_CPUS=0.75
INKTIME_WEB_MEMORY=384m
INKTIME_WEB_PIDS=128
INKTIME_WORKER_CPUS=2.0
INKTIME_WORKER_MEMORY=1g
INKTIME_WORKER_PIDS=192
INKTIME_SCHEDULER_CPUS=0.25
INKTIME_SCHEDULER_MEMORY=192m
INKTIME_SCHEDULER_PIDS=64
