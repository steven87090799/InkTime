# Trusted LAN / local HTTP only. Do not expose this mode to the public Internet.
TZ=Asia/Taipei
INKTIME_PORT=8765
# Development only: expose the Web port to a physical ESP32 on the trusted LAN.
# Use the Mac's exact LAN IP instead of 0.0.0.0 when you want a narrower bind.
INKTIME_DEV_BIND_ADDRESS=0.0.0.0
# Replace this example with the Mac's current RFC1918 LAN IP.
INKTIME_DEV_PUBLIC_URL=http://192.168.0.50:8765
INKTIME_DATA_PATH=./data
INKTIME_PHOTO_PATH=./simulation_photos
INKTIME_ENVIRONMENT=development
INKTIME_PUBLIC_URL=http://localhost:8765
INKTIME_COOKIE_SECURE=0
INKTIME_ALLOW_INSECURE_HTTP=1
INKTIME_ALLOW_UNSAFE_NETWORK_DATABASE=0
INKTIME_PROXY_TRUST=0
INKTIME_IMAGE_TAG=local
