{
  "schema_version": 1,
  "description": "Machine-readable AI editing routes and default read boundaries for InkTime.",
  "context_command": "python scripts/ci/ai_context.py <task-id>",
  "default_policy": {
    "first_pass_max_files": 3,
    "first_pass_max_lines": 300,
    "expand_requires_evidence": true,
    "full_audit_requires_explicit_request": true,
    "hardware_exception": "Read docs/devices/PHOTOPAINTER_SAFETY_CONTRACT.md first for hardware safety tasks; historical evidence on demand.",
    "deferred_globs": [
      ".env*",
      "*.db",
      "*.sqlite*",
      "*.lock",
      "data/**",
      "output/**",
      "photos/**",
      "simulation_photos/**",
      "logs/**",
      ".git/**",
      "docs/archive/**",
      "**/*.ttf",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.pdf",
      "**/*.zip",
      "**/*.bin",
      "**/*.elf",
      "**/*.hex",
      "**/*.uf2",
      "**/*.o",
      "**/*.a",
      "README.md",
      "README.en.md",
      "USER_MANUAL.html",
      "docs/README.md",
      "~/.codex/memories/**",
      "docs/reports/**",
      "docs/CODE_REVIEW_REPORT.md",
      "docs/operations/*_20*.md",
      ".ruff_cache/**",
      "**/__pycache__/**",
      ".venv/**",
      "node_modules/**",
      "build/**",
      "dist/**",
      "**/session.key*",
      "**/*.jsonl"
    ],
    "targeted_skip_context_tool": true,
    "default_route_max_items": 6,
    "default_route_reads_source": false,
    "normal_tool_output_max_lines": 120
  },
  "task_routes": [
    {
      "id": "startup",
      "entrypoints": [
        "inktime/app/factory.py",
        "inktime/app/bootstrap.py"
      ],
      "contracts": [
        "docs/architecture/APPLICATION_FACTORY.md"
      ],
      "tests": [
        "tests/**/test_application_factory.py"
      ]
    },
    {
      "id": "scanner_photos",
      "entrypoints": [
        "inktime/app/workers/scanner.py",
        "inktime/app/domain/photos/preprocessing.py"
      ],
      "contracts": [
        "docs/guides/LOCAL_ONLY_SELECTION_ZH_TW.md"
      ],
      "tests": [
        "tests/**/test_scanner*.py",
        "tests/**/test_local_only_mode.py"
      ]
    },
    {
      "id": "openai_batch",
      "entrypoints": [
        "inktime/app/services/batch_analysis.py",
        "inktime/app/providers/openai_batch.py"
      ],
      "contracts": [
        "docs/OPENAI_BATCH_ANALYSIS_ZH_TW.md"
      ],
      "tests": [
        "tests/**/test_batch_analysis*.py"
      ]
    },
    {
      "id": "jobs_workers",
      "entrypoints": [
        "inktime/app/workers/runner.py",
        "inktime/app/workers/scheduler.py",
        "inktime/app/services/jobs.py"
      ],
      "contracts": [
        "docs/guides/ACTIVITY_AI_TRACE_ZH_TW.md"
      ],
      "tests": [
        "tests/**/test_jobs*.py",
        "tests/**/test_scheduler*.py"
      ]
    },
    {
      "id": "analysis_prompt_schema",
      "entrypoints": [
        "inktime/app/domain/analysis/schema.py",
        "inktime/app/providers/openai_compatible.py"
      ],
      "contracts": [
        "docs/VISION_SCHEMA.md"
      ],
      "tests": [
        "tests/**/test_scoring*.py",
        "tests/**/test_vision_v4.py"
      ],
      "purpose": "Prompt assembly and current output schema"
    },
    {
      "id": "analysis_ranking",
      "entrypoints": [
        "inktime/app/domain/analysis/scoring.py"
      ],
      "contracts": [
        "docs/analysis/PHOTO_SELECTION_AI_FIRST_ZH_TW.md"
      ],
      "tests": [
        "tests/**/test_scoring*.py",
        "tests/**/test_vision_v4.py"
      ],
      "purpose": "67/33 weights, special bonus and favorite"
    },
    {
      "id": "analysis_runtime",
      "entrypoints": [
        "inktime/app/services/analysis.py",
        "inktime/app/domain/analysis/plan.py"
      ],
      "contracts": [
        "docs/reference/TOKEN_COST_GUIDE_ZH_TW.md"
      ],
      "tests": [
        "tests/**/test_analysis*.py",
        "tests/**/test_ai_cache_singleflight.py"
      ],
      "purpose": "Vision lifecycle, cache, retry and persistence"
    },
    {
      "id": "providers_usage",
      "entrypoints": [
        "inktime/app/providers/router.py"
      ],
      "contracts": [
        "docs/providers/OPENROUTER_ZH_TW.md",
        "docs/guides/ACTIVITY_AI_TRACE_ZH_TW.md"
      ],
      "tests": [
        "tests/**/test_provider*.py",
        "tests/**/test_usage*.py"
      ],
      "purpose": "Locate active provider before reading usage/budget dependencies"
    },
    {
      "id": "release_selection",
      "entrypoints": [
        "inktime/app/repositories/render_candidates.py",
        "inktime/app/services/display_prepare.py"
      ],
      "contracts": [
        "docs/analysis/PHOTO_SELECTION_AI_FIRST_ZH_TW.md"
      ],
      "tests": [
        "tests/**/test_render_candidate_contract.py"
      ],
      "purpose": "Candidate qualification and automatic release"
    },
    {
      "id": "rendering",
      "entrypoints": [
        "inktime/app/services/rendering.py"
      ],
      "contracts": [
        "docs/architecture/ARCHITECTURE_ZH_TW.md"
      ],
      "tests": [
        "tests/**/test_*render*.py",
        "tests/**/test_adaptive_frame_renderer.py"
      ],
      "purpose": "Locate named renderer before domain helpers"
    },
    {
      "id": "release_lifecycle",
      "entrypoints": [
        "inktime/app/services/release_coordinator.py"
      ],
      "contracts": [
        "docs/architecture/ARCHITECTURE_ZH_TW.md"
      ],
      "tests": [
        "tests/**/test_*render*.py",
        "tests/**/test_adaptive_frame_renderer.py"
      ],
      "purpose": "Publication, rollback and release lifecycle"
    },
    {
      "id": "web_ui",
      "entrypoints": [
        "inktime/app/web/templates/settings.html",
        "inktime/app/api/settings.py"
      ],
      "contracts": [
        "docs/guides/ADMIN_GUIDE_ZH_TW.md"
      ],
      "tests": [
        "tests/**/test_*api*.py",
        "tests/**/test_settings*.py"
      ],
      "purpose": "Settings UI example; known screens should start directly at their own template"
    },
    {
      "id": "settings_registry",
      "entrypoints": [
        "inktime/app/repositories/settings.py"
      ],
      "contracts": [
        "docs/guides/ADMIN_GUIDE_ZH_TW.md"
      ],
      "tests": [
        "tests/**/test_*api*.py",
        "tests/**/test_settings*.py"
      ],
      "purpose": "Search the exact setting key"
    },
    {
      "id": "database_repository",
      "entrypoints": [
        "inktime/app/repositories/photos.py"
      ],
      "contracts": [
        "docs/operations/MIGRATION_GUIDE_ZH_TW.md"
      ],
      "tests": [
        "tests/**/test_migrations.py",
        "tests/**/test_*retention*.py"
      ],
      "purpose": "Photo repository example; use exact method in the affected repository"
    },
    {
      "id": "database_migrations",
      "entrypoints": [
        "inktime/app/db/migrations.py"
      ],
      "contracts": [
        "docs/operations/MIGRATION_GUIDE_ZH_TW.md"
      ],
      "tests": [
        "tests/**/test_migrations.py",
        "tests/**/test_*retention*.py"
      ],
      "purpose": "Locate exact migration version; preserve released migrations"
    },
    {
      "id": "device_pairing",
      "entrypoints": [
        "inktime/app/api/device_pairing.py"
      ],
      "contracts": [
        "docs/devices/ESP32_AUTOMATIC_PAIRING_ZH_TW.md"
      ],
      "tests": [
        "tests/**/test_device*.py"
      ],
      "purpose": "Pairing endpoints and state"
    },
    {
      "id": "device_offline_queue",
      "entrypoints": [
        "inktime/app/services/device_queue_manifests.py",
        "inktime/app/api/devices.py"
      ],
      "contracts": [
        "docs/devices/ESP32_AUTOMATIC_PAIRING_ZH_TW.md"
      ],
      "tests": [
        "tests/**/test_device*.py"
      ],
      "purpose": "Offline manifests, queue and ACK"
    },
    {
      "id": "hardware_safety",
      "entrypoints": [
        "docs/devices/PHOTOPAINTER_SAFETY_CONTRACT.md"
      ],
      "contracts": [
        "docs/devices/PHOTOPAINTER_SAFETY_CONTRACT.md"
      ],
      "tests": [
        "tests/**/test_esp32*.py"
      ],
      "purpose": "Read safety contract before named firmware symbols"
    },
    {
      "id": "ci_failure",
      "entrypoints": [
        ".github/workflows/ci.yml"
      ],
      "contracts": [
        "docs/CI_POLICY.md"
      ],
      "tests": [
        "tests/unit/test_ci_*.py"
      ],
      "purpose": "Start with exact failing job/error and testcase"
    },
    {
      "id": "operations_runtime",
      "entrypoints": [
        "scripts/update_nas.sh"
      ],
      "contracts": [
        "docs/operations/NAS_TAG_DEPLOYMENT_ZH_TW.md"
      ],
      "tests": [
        "tests/unit/test_ci_*.py"
      ],
      "purpose": "NAS runtime/update entry point; expand from actual error"
    },
    {
      "id": "documentation_baseline",
      "entrypoints": [
        "docs/reference/CURRENT_STATE_ZH_TW.md"
      ],
      "contracts": [
        "docs/README.md",
        "README.md"
      ],
      "tests": []
    }
  ],
  "required_navigation_links": [
    "AGENTS.md",
    "docs/AI_NAVIGATION.md",
    "docs/AI_CONTEXT_INDEX.json"
  ],
  "large_file_policy": {
    "threshold_bytes": 50000,
    "policy": "symbol-first; bounded read of normally 40–120 lines; applies to every text file, including tests"
  },
  "route_aliases": {
    "analysis_scoring": "analysis_ranking",
    "analysis_pipeline": "analysis_runtime",
    "selection_release": "release_selection",
    "rendering_release": "rendering",
    "web_settings": "settings_registry",
    "database_retention": "database_migrations",
    "devices_pairing_queue": "device_offline_queue",
    "photopainter_hardware": "hardware_safety",
    "operations_ci": "ci_failure"
  }
}
