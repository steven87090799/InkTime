{
  "schema_version": 1,
  "description": "Machine-readable AI editing routes and default read boundaries for InkTime.",
  "context_command": "python scripts/ci/ai_context.py <task-id>",
  "default_policy": {
    "first_pass_max_files": 4,
    "first_pass_max_lines": 800,
    "expand_requires_evidence": true,
    "full_audit_requires_explicit_request": true,
    "forbidden_globs": [
      ".env*",
      "*.db",
      "*.sqlite*",
      "*.lock",
      "data/**",
      "output/**",
      "photos/**",
      "simulation_photos/**",
      "logs/**",
      ".git/**",
      "docs/archive/**",
      "**/*.ttf",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.pdf",
      "**/*.zip",
      "**/*.bin",
      "**/*.elf",
      "**/*.hex",
      "**/*.uf2",
      "**/*.o",
      "**/*.a"
    ],
    "hardware_exception": "Read both PhotoPainter handoff documents in full before hardware work."
  },
  "task_routes": [
    {
      "id": "startup",
      "entrypoints": ["inktime/app/factory.py", "inktime/app/bootstrap.py"],
      "contracts": ["docs/architecture/APPLICATION_FACTORY.md"],
      "tests": ["tests/**/test_application_factory.py"]
    },
    {
      "id": "scanner_photos",
      "entrypoints": ["inktime/app/workers/scanner.py", "inktime/app/domain/photos/preprocessing.py"],
      "contracts": ["docs/guides/LOCAL_ONLY_SELECTION_ZH_TW.md"],
      "tests": ["tests/**/test_scanner*.py", "tests/**/test_local_only_mode.py"]
    },
    {
      "id": "analysis_scoring",
      "entrypoints": [
        "inktime/app/domain/analysis/scoring.py",
        "inktime/app/domain/analysis/plan.py",
        "inktime/app/domain/analysis/schema.py"
      ],
      "contracts": [
        "docs/VISION_SCHEMA_V4.md",
        "docs/analysis/PHOTO_SELECTION_AI_FIRST_ZH_TW.md"
      ],
      "tests": ["tests/**/test_scoring*.py", "tests/**/test_vision_v4.py"]
    },
    {
      "id": "analysis_pipeline",
      "entrypoints": ["inktime/app/services/analysis.py", "inktime/app/domain/analysis/plan.py"],
      "contracts": ["docs/reference/TOKEN_COST_GUIDE_ZH_TW.md"],
      "tests": ["tests/**/test_analysis*.py", "tests/**/test_ai_cache_singleflight.py"]
    },
    {
      "id": "providers_usage",
      "entrypoints": [
        "inktime/app/providers/router.py",
        "inktime/app/services/usage_tracking.py",
        "inktime/app/services/budgets.py"
      ],
      "contracts": [
        "docs/providers/OPENROUTER_ZH_TW.md",
        "docs/guides/ACTIVITY_AI_TRACE_ZH_TW.md"
      ],
      "tests": ["tests/**/test_provider*.py", "tests/**/test_usage*.py"]
    },
    {
      "id": "openai_batch",
      "entrypoints": ["inktime/app/services/batch_analysis.py", "inktime/app/providers/openai_batch.py"],
      "contracts": ["docs/OPENAI_BATCH_ANALYSIS_ZH_TW.md"],
      "tests": ["tests/**/test_batch_analysis*.py"]
    },
    {
      "id": "jobs_workers",
      "entrypoints": [
        "inktime/app/workers/runner.py",
        "inktime/app/workers/scheduler.py",
        "inktime/app/services/jobs.py"
      ],
      "contracts": ["docs/guides/ACTIVITY_AI_TRACE_ZH_TW.md"],
      "tests": ["tests/**/test_jobs*.py", "tests/**/test_scheduler*.py"]
    },
    {
      "id": "selection_release",
      "entrypoints": [
        "inktime/app/repositories/render_candidates.py",
        "inktime/app/services/display_prepare.py"
      ],
      "contracts": ["docs/analysis/PHOTO_SELECTION_AI_FIRST_ZH_TW.md"],
      "tests": ["tests/**/test_render_candidate_contract.py"]
    },
    {
      "id": "rendering_release",
      "entrypoints": [
        "inktime/app/services/rendering.py",
        "inktime/app/services/release_coordinator.py",
        "inktime/app/domain/rendering"
      ],
      "contracts": ["docs/architecture/ARCHITECTURE_ZH_TW.md"],
      "tests": ["tests/**/test_*render*.py", "tests/**/test_adaptive_frame_renderer.py"]
    },
    {
      "id": "web_settings",
      "entrypoints": [
        "inktime/app/api",
        "inktime/app/services",
        "inktime/app/web/templates",
        "inktime/app/repositories/settings.py"
      ],
      "contracts": ["docs/guides/ADMIN_GUIDE_ZH_TW.md"],
      "tests": ["tests/**/test_*api*.py", "tests/**/test_settings*.py"]
    },
    {
      "id": "database_retention",
      "entrypoints": ["inktime/app/db/migrations.py", "inktime/app/repositories"],
      "contracts": ["docs/operations/MIGRATION_GUIDE_ZH_TW.md"],
      "tests": ["tests/**/test_migrations.py", "tests/**/test_*retention*.py"]
    },
    {
      "id": "devices_pairing_queue",
      "entrypoints": [
        "inktime/app/api/devices.py",
        "inktime/app/api/device_pairing.py",
        "inktime/app/services/device_queue_manifests.py"
      ],
      "contracts": ["docs/devices/ESP32_AUTOMATIC_PAIRING_ZH_TW.md"],
      "tests": ["tests/**/test_device*.py"]
    },
    {
      "id": "photopainter_hardware",
      "entrypoints": [
        "esp32/ink-display-7C-photo/ink-display-7C-photo.ino",
        "esp32/ink-display-7C-photo/photopainter_support.cpp"
      ],
      "contracts": [
        "docs/devices/PHOTOPAINTER_REV2_TG28_HARDWARE_HANDOFF_ZH_TW.md",
        "docs/devices/WAVESHARE_PHOTOPAINTER_ZH_TW.md"
      ],
      "tests": ["tests/**/test_esp32*.py"],
      "read_policy": "Read both hardware contracts in full before source."
    },
    {
      "id": "operations_ci",
      "entrypoints": [".github/workflows/ci.yml", "scripts"],
      "contracts": [
        "docs/CI_POLICY.md",
        "docs/operations/NAS_TAG_DEPLOYMENT_ZH_TW.md"
      ],
      "tests": ["tests/unit/test_ci_*.py"]
    },
    {
      "id": "documentation_baseline",
      "entrypoints": ["docs/reference/CURRENT_STATE_ZH_TW.md"],
      "contracts": ["docs/README.md", "README.md"],
      "tests": []
    }
  ],
  "large_files": [
    {"path": "USER_MANUAL.html", "min_bytes": 100000, "policy": "Read only named sections."},
    {"path": "README.md", "min_bytes": 40000, "policy": "Use AI navigation and named headings."},
    {"path": "inktime/app/db/migrations.py", "min_bytes": 100000, "policy": "Read only the migration and callers involved."},
    {"path": "inktime/app/services/batch_analysis.py", "min_bytes": 100000, "policy": "Locate the named lifecycle function first."},
    {"path": "inktime/app/services/rendering.py", "min_bytes": 100000, "policy": "Locate the named renderer or contract first."},
    {"path": "inktime/app/repositories/photos.py", "min_bytes": 100000, "policy": "Locate the named query or repository method first."},
    {"path": "inktime/app/repositories/settings.py", "min_bytes": 90000, "policy": "Locate the setting key and default first."},
    {"path": "inktime/app/services/analysis.py", "min_bytes": 80000, "policy": "Locate the plan, cache, or repair function first."},
    {"path": "esp32/ink-display-7C-photo/ink-display-7C-photo.ino", "min_bytes": 200000, "policy": "Read only after the hardware contracts and named symbols."}
  ],
  "required_navigation_links": [
    "AGENTS.md",
    "docs/AI_NAVIGATION.md",
    "docs/AI_CONTEXT_INDEX.json"
  ]
}
